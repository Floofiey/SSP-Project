element1:
  name: Pod Security Standards
  requirements:
  - Enable Pod Security Admission
  - Ensure that only approved services are running
  - Limit the admission of privileged containers
element10:
  name: Network Security
  requirements:
  - Secure network infrastructure
  - Limit the use of webhooks
element11:
  name: Security Best Practices
  requirements:
  - Minimize the admission of privileged containers
  - Regularly review and update cluster roles and policies
element2:
  name: Automated Updates
  requirements:
  - Regularly review and update cluster roles and policies
  - Ensure that the cluster is automatically updated
element3:
  name: RBAC and Service Accounts
  requirements:
  - Restrict access to secrets to dedicated administrators
  - Securely manage user roles and permissions
  - Implement least privilege
element4:
  name: Network Security
  requirements:
  - Secure network infrastructure
  - Limit the use of webhooks
element5:
  name: Pod Security Policies (Preview)
  requirements:
  - Disable the feature if it's deprecated
  - Review existing policies and ensure that they're appropriate
element6:
  name: Access Control Policies
  requirements:
  - Implement Role-Based Access Control (RBAC)
  - Ensure that permissions are not overly broad
element7:
  name: Continuous Monitoring
  requirements:
  - Monitor cluster security
  - Audit logging events
element8:
  name: Configuration Management
  requirements:
  - Minimize the admission of privileged containers
  - Utilize a secure configuration process
element9:
  name: Service Account Token Creation
  requirements:
  - Limit the use of service account token creation
  - Disable automatic service account token creation
